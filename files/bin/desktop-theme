#!/usr/bin/env bash
echo "$(date '+%Y-%m-%d %H:%M:%S'): desktop-theme called with $@" >> /tmp/desktop-theme.log
set -e

MODE_FILE="$HOME/.config/desktop-theme-mode"

apply_light() {
    echo "Switching to Light Mode..."
    
    # 1. Apply Light Color Scheme
    plasma-apply-colorscheme ModernLight
    
    # 2. Apply Modern Dock Light Plasma Theme
    plasma-apply-desktoptheme modern-dock-light
    
    # 3. Apply Papirus icon theme (optimized for light panels)
    kwriteconfig6 --file kdeglobals --group Icons --key Theme Papirus
    
    # 4. Apply GTK 3/4 light themes & GNOME interface portal
    mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
    kwriteconfig6 --file "$HOME/.config/gtk-3.0/settings.ini" --group Settings --key gtk-theme-name Breeze
    kwriteconfig6 --file "$HOME/.config/gtk-3.0/settings.ini" --group Settings --key gtk-icon-theme-name Papirus
    kwriteconfig6 --file "$HOME/.config/gtk-3.0/settings.ini" --group Settings --key gtk-application-prefer-dark-theme false
    kwriteconfig6 --file "$HOME/.config/gtk-4.0/settings.ini" --group Settings --key gtk-theme-name Breeze
    kwriteconfig6 --file "$HOME/.config/gtk-4.0/settings.ini" --group Settings --key gtk-icon-theme-name Papirus
    kwriteconfig6 --file "$HOME/.config/gtk-4.0/settings.ini" --group Settings --key gtk-application-prefer-dark-theme false
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-light' >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface gtk-theme 'Breeze' >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus' >/dev/null 2>&1 || true
    
    # 5. Apply Dolphin Explorer Light QSS
    cp "$HOME/.config/dolphin-light.qss" "$HOME/.config/dolphin.qss"
    
    # 6. Notify KWin & Plasma
    qdbus6 org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
    
    # 7. If Dolphin is running, refresh it
    if pgrep -x dolphin >/dev/null 2>&1; then
        killall dolphin 2>/dev/null || true
        nohup "$HOME/.local/bin/dolphin" >/dev/null 2>&1 &
    fi
    
    # 8. Set Konsole default profile to Modern Light
    kwriteconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile ModernLight.profile
    
    # 9. Sync Lock Screen Wallpaper to Light
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "/usr/share/wallpapers/Flow/contents/images/5120x2880.jpg"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key PreviewImage "/usr/share/wallpapers/Flow/contents/images/5120x2880.jpg"
    
    echo "light" > "$MODE_FILE"
    echo "Successfully switched to Light Mode."
}

apply_dark() {
    echo "Switching to Dark Mode..."
    
    # 1. Apply Dark Color Scheme
    plasma-apply-colorscheme ModernDark
    
    # 2. Apply Modern Dock Dark Plasma Theme
    plasma-apply-desktoptheme modern-dock
    
    # 3. Apply Papirus-Dark icon theme
    kwriteconfig6 --file kdeglobals --group Icons --key Theme Papirus-Dark
    
    # 4. Apply GTK 3/4 dark themes & GNOME interface portal
    mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
    kwriteconfig6 --file "$HOME/.config/gtk-3.0/settings.ini" --group Settings --key gtk-theme-name Breeze-Dark
    kwriteconfig6 --file "$HOME/.config/gtk-3.0/settings.ini" --group Settings --key gtk-icon-theme-name Papirus-Dark
    kwriteconfig6 --file "$HOME/.config/gtk-3.0/settings.ini" --group Settings --key gtk-application-prefer-dark-theme true
    kwriteconfig6 --file "$HOME/.config/gtk-4.0/settings.ini" --group Settings --key gtk-theme-name Breeze-Dark
    kwriteconfig6 --file "$HOME/.config/gtk-4.0/settings.ini" --group Settings --key gtk-icon-theme-name Papirus-Dark
    kwriteconfig6 --file "$HOME/.config/gtk-4.0/settings.ini" --group Settings --key gtk-application-prefer-dark-theme true
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface gtk-theme 'Breeze-Dark' >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark' >/dev/null 2>&1 || true
    
    # 5. Apply Dolphin Explorer Dark QSS
    cp "$HOME/.config/dolphin-dark.qss" "$HOME/.config/dolphin.qss"
    
    # 6. Notify KWin & Plasma
    qdbus6 org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
    
    # 7. If Dolphin is running, refresh it
    if pgrep -x dolphin >/dev/null 2>&1; then
        killall dolphin 2>/dev/null || true
        nohup "$HOME/.local/bin/dolphin" >/dev/null 2>&1 &
    fi
    
    # 8. Set Konsole default profile to Modern Dark
    kwriteconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile ModernDark.profile
    
    # 9. Sync Lock Screen Wallpaper to Dark
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "/usr/share/wallpapers/DarkestHour/contents/images/2560x1600.jpg"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key PreviewImage "/usr/share/wallpapers/DarkestHour/contents/images/2560x1600.jpg"
    
    echo "dark" > "$MODE_FILE"
    echo "Successfully switched to Dark Mode."
}

get_current_mode() {
    if [ -f "$MODE_FILE" ]; then
        cat "$MODE_FILE"
    else
        echo "dark"
    fi
}

case "$1" in
    light)
        apply_light
        ;;
    dark)
        apply_dark
        ;;
    toggle)
        CURRENT=$(get_current_mode)
        if [ "$CURRENT" = "light" ]; then
            apply_dark
        else
            apply_light
        fi
        ;;
    status)
        echo "Current mode: $(get_current_mode)"
        ;;
    *)
        echo "Usage: desktop-theme {light|dark|toggle|status}"
        exit 1
        ;;
esac
