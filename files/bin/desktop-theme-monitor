#!/usr/bin/env python3
import os, time, subprocess

CONFIG_PATH = os.path.expanduser("~/.config/kdeglobals")
MODE_FILE = os.path.expanduser("~/.config/desktop-theme-mode")
THEME_SWITCHER = os.path.expanduser("~/.local/bin/desktop-theme")

def get_current_mode():
    if os.path.exists(MODE_FILE):
        try:
            with open(MODE_FILE, "r") as f:
                return f.read().strip()
        except Exception:
            pass
    return "dark"

def get_scheme_from_kdeglobals():
    if not os.path.exists(CONFIG_PATH):
        return None
    try:
        with open(CONFIG_PATH, "r") as f:
            for line in f:
                if line.startswith("ColorScheme="):
                    return line.split("=", 1)[1].strip()
    except Exception:
        pass
    return None

def is_light_scheme(scheme_name):
    if not scheme_name:
        return False
    name = scheme_name.lower()
    return "light" in name

def main():
    last_mtime = 0
    last_processed_scheme = None

    while True:
        try:
            if os.path.exists(CONFIG_PATH):
                mtime = os.path.getmtime(CONFIG_PATH)
                if mtime != last_mtime:
                    last_mtime = mtime
                    scheme = get_scheme_from_kdeglobals()
                    if scheme and scheme != last_processed_scheme:
                        last_processed_scheme = scheme
                        current_mode = get_current_mode()
                        is_light = is_light_scheme(scheme)
                        
                        if is_light and current_mode != "light":
                            subprocess.run([THEME_SWITCHER, "light"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        elif not is_light and current_mode != "dark":
                            subprocess.run([THEME_SWITCHER, "dark"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        time.sleep(1)

if __name__ == "__main__":
    main()
