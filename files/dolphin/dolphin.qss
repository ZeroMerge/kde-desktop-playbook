* {
    background-color: #141618;
    color: #fcfcfc;
}

QMainWindow, QDockWidget, QToolBar {
    background-color: #202326;
    border: none;
}

QToolBar::separator {
    background: transparent;
    width: 0px;
    height: 0px;
    border: none;
}

QMainWindow::separator {
    background: transparent;
    width: 0px;
    height: 0px;
    border: none;
}

QSplitter::handle {
    background: transparent;
    width: 0px;
    height: 0px;
    border: none;
}

/* Breadcrumb / Path Bar */
KUrlNavigator, KUrlNavigator > QWidget {
    background-color: #202326;
    color: #fcfcfc;
    border: none;
}

KUrlNavigatorButton {
    background-color: transparent;
    color: #fcfcfc;
    border: none;
    padding: 3px 6px;
    border-radius: 4px;
}

KUrlNavigatorButton:hover {
    background-color: #2b2f38;
    color: #ffffff;
}

KUrlNavigatorButton:checked, KUrlNavigatorButton:pressed {
    background-color: #3c485c;
    color: #ffffff;
}

KUrlNavigator QLineEdit, KUrlComboBox {
    background-color: #141618;
    color: #fcfcfc;
    border: 1px solid #3c485c;
    border-radius: 4px;
    padding: 3px 6px;
}

/* Places Sidebar: generous side padding and floating rounded pill highlight */
QDockWidget QListView {
    background-color: #202326;
    border: none;
    outline: none;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

QDockWidget QListView::item {
    margin-left: 10px;
    margin-right: 10px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 4px;
    border: none;
    color: #fcfcfc;
}

QDockWidget QListView::item:selected {
    background-color: #3c485c;
    color: #ffffff;
    border: none;
}

QDockWidget QListView::item:selected:active {
    background-color: #3c485c;
    color: #ffffff;
    border: none;
}

QDockWidget QListView::item:selected:!active {
    background-color: #3c485c;
    color: #ffffff;
    border: none;
}

QDockWidget QListView::item:hover {
    background-color: #272d38;
    color: #ffffff;
    border: none;
}
